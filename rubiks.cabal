cabal-version:   3.0
name:            cubectl
version:         0.1.0.0
license:         AGPL-3.0-only
license-file:    LICENSE
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
    ghc-options: -Wall

executable cubectl
    import:           warnings
    main-is:          Rubiks.hs
    build-depends:
        base ^>=4.18.2.1,
        text-ansi ^>= 0.3.0.1,
        containers,
        optics-core ^>=0.4.1.1,
        random ^>= 1.2.1.1,
        random-shuffle ^>=0.0.4,
        vector,
        pretty-simple,
    hs-source-dirs:   .
    default-language: GHC2021
